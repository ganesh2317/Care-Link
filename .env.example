# ─── CareLink Environment ───────────────────────────────────────
# Copy this file to .env and update values for your machine.

# Express server port
PORT=3000

# SQLite database file path (relative to project root)
DATABASE_PATH=./server/carelink.db

# Default caregiver ID (no auth in this prototype)
DEFAULT_CAREGIVER_ID=cg_demo

# Public base URL for QR codes.
# In dev mode the client defaults to window.location.origin if this is blank,
# so the easiest setup is to open the dashboard using your LAN IP:
#   http://<YOUR_LAN_IP>:5173/dashboard
#
# To find your LAN IP:
#   Windows:  ipconfig → look for "IPv4 Address"
#   macOS:    ipconfig getifaddr en0
#   Linux:    hostname -I
#
# Only set this if you need to override the auto-detected origin:
# VITE_PUBLIC_BASE_URL=http://192.168.1.42:5173
